{
  "name": "federalist-uswds-jekyll",
  "version": "1.3.0",
  "scripts": {
    "local": "bundler install && sleep 5 && npm install",
    "build": "bundle exec jekyll build",
    "pages": "npm run c2pa:install-tool && npm run c2pa:dry-run && npm run c2pa:sign-source && npm run c2pa:ui",
    "c2pa:inventory": "node scripts/c2pa/inventory.mjs",
    "c2pa:dry-run": "node scripts/c2pa/inventory.mjs --dry-run",
    "c2pa:dry-run:samples": "node scripts/c2pa/sign-samples.mjs",
    "c2pa:sign-source": "node scripts/c2pa/sign.mjs",
    "c2pa:ui": "node scripts/c2pa/build-ui.mjs",
    "c2pa:install-tool": "node scripts/c2pa/install-tool.mjs",
    "clean": "bundle exec jekyll clean",
    "reset": "npx rimraf .git",
    "start": "bundle exec jekyll serve --livereload",
    "start-detached": "bundle exec jekyll serve --detach",
    "htmlproofer": "bundle exec htmlproofer --no-enforce-https --allow-missing-href _site",
    "pa11y-ci:sitemap": "pa11y-ci --sitemap http://localhost:4000/sitemap.xml --sitemap-exclude \"/*.pdf\""
  },
  "dependencies": {
    "@contentauth/c2pa-web": "0.14.4",
    "@uswds/uswds": "3.13.0",
    "esbuild": "0.28.2",
    "scss": "^0.2.4"
  },
  "devDependencies": {
    "pa11y-ci": "^4.1.1",
    "rimraf": "^3.0.2"
  }
}
