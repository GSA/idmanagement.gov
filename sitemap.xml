---
# File: sitemap.xml for IDManagement.gov
# Note: Collection-based: Each collection added to the site should be added here also
# Date: 1026/2023
#
layout: 
---

<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9 http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd" xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  
  <!-- arch collection (FICAM) -->
  {% for docs in site.arch %}
      <url>
        <loc>{{ site.url }}{{ docs.permalink }}</loc>
        <changefreq>weekly</changefreq>
        <priority>1.0</priority>
       </url>
    {% for sub in docs.subnav %}
      <url>
        <loc>{{ site.url }}{{docs.permalink}}{{ sub.href }}</loc>
        <changefreq>weekly</changefreq>
        <priority>1.0</priority>
       </url>
    {% endfor %}
  {% endfor %}

  <!-- partners collection (Partners) -->
  {% for docs in site.partners %}
      <url>
        <loc>{{ site.url }}{{ docs.permalink }}</loc>
        <changefreq>weekly</changefreq>
        <priority>1.0</priority>
       </url>
    {% for sub in docs.subnav %}
      <url>
        <loc>{{ site.url }}{{docs.permalink}}{{ sub.href }}</loc>
        <changefreq>weekly</changefreq>
        <priority>1.0</priority>
       </url>
    {% endfor %}
  {% endfor %}

  <!-- implement collection (Implement) -->
  {% for docs in site.implement %}
      <url>
        <loc>{{ site.url }}{{ docs.permalink }}</loc>
        <changefreq>weekly</changefreq>
        <priority>1.0</priority>
       </url>
    {% for sub in docs.subnav %}
      <url>
        <loc>{{ site.url }}{{docs.permalink}}{{ sub.href }}</loc>
        <changefreq>weekly</changefreq>
        <priority>1.0</priority>
       </url>
    {% endfor %}
  {% endfor %}

    <!-- ficampmo collection (Functions) -->
  {% for docs in site.ficampmo %}
      <url>
        <loc>{{ site.url }}{{ docs.permalink }}</loc>
        <changefreq>weekly</changefreq>
        <priority>1.0</priority>
       </url>
    {% for sub in docs.subnav %}
      <url>
        <loc>{{ site.url }}{{docs.permalink}}{{ sub.href }}</loc>
        <changefreq>weekly</changefreq>
        <priority>1.0</priority>
       </url>
    {% endfor %}
  {% endfor %}

  <!-- playbooks collection (Playbooks) -->
  {% for docs in site.playbooks %}
      <url>
        <loc>{{ site.url }}{{ docs.permalink }}</loc>
        <changefreq>weekly</changefreq>
        <priority>1.0</priority>
       </url>
    {% for sub in docs.subnav %}
      <url>
        <loc>{{ site.url }}{{docs.permalink}}{{ sub.href }}</loc>
        <changefreq>weekly</changefreq>
        <priority>1.0</priority>
       </url>
    {% endfor %}
  {% endfor %}

  <!-- university collection (University) -->
  {% for docs in site.university %}
      <url>
        <loc>{{ site.url }}{{ docs.permalink }}</loc>
        <changefreq>weekly</changefreq>
        <priority>1.0</priority>
       </url>
    {% for sub in docs.subnav %}
      <url>
        <loc>{{ site.url }}{{docs.permalink}}{{ sub.href }}</loc>
        <changefreq>weekly</changefreq>
        <priority>1.0</priority>
       </url>
    {% endfor %}
  {% endfor %}
  
  <!-- experiments collection (Experiments) -->
  {% for docs in site.experiments %}
      <url>
        <loc>{{ site.url }}{{ docs.permalink }}</loc>
        <changefreq>weekly</changefreq>
        <priority>1.0</priority>
       </url>
    {% for sub in docs.subnav %}
      <url>
        <loc>{{ site.url }}{{docs.permalink}}{{ sub.href }}</loc>
        <changefreq>weekly</changefreq>
        <priority>1.0</priority>
       </url>
    {% endfor %}
  {% endfor %}

  <!-- Pages (Only a few pages)  -->
  {% for page in site.pages %}
    {% if page.url contains '.xml' or page.url contains 'assets' or page.url contains '.ttf' or page.url contains '.woff' or page.url contains 'woff2' %}{% else %}
        <url>
          <loc>{{ site.url }}{{ page.url }}</loc>
          <changefreq>monthly</changefreq>
          <priority>1.0</priority>
        </url>
    {% endif %}
  {% endfor %}

</urlset>